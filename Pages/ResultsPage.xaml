<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="The_codebreakers___The_Vault.Pages.ResultsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource VaultBackground}"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            x:Name="ResultsContent"
            Padding="28,52,28,32"
            Spacing="22"
            HorizontalOptions="Center"
            MaximumWidthRequest="520"
            Opacity="0"
            Scale="0.88">

            <VerticalStackLayout Spacing="6">
                <Label
                    Text="VAULT OPENED"
                    TextColor="{StaticResource VaultGreen}"
                    FontSize="34"
                    FontAttributes="Bold"
                    CharacterSpacing="3"
                    HorizontalTextAlignment="Center"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    x:Name="SuccessLabel"
                    TextColor="{StaticResource VaultText}"
                    FontSize="18"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource VaultCard}">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="SECRET CODE"
                        TextColor="{StaticResource VaultMuted}"
                        FontSize="12"
                        FontAttributes="Bold"
                        CharacterSpacing="1.5"
                        HorizontalTextAlignment="Center" />
                    <Label
                        x:Name="SecretCodeLabel"
                        TextColor="{StaticResource VaultGreen}"
                        FontSize="42"
                        FontAttributes="Bold"
                        CharacterSpacing="10"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource VaultCard}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="12">
                    <Label Text="Player" TextColor="{StaticResource VaultMuted}" />
                    <Label x:Name="PlayerResultLabel" Grid.Column="1" TextColor="{StaticResource VaultText}" FontAttributes="Bold" />
                    <Label Grid.Row="1" Text="Difficulty" TextColor="{StaticResource VaultMuted}" />
                    <Label x:Name="DifficultyResultLabel" Grid.Row="1" Grid.Column="1" TextColor="{StaticResource VaultText}" FontAttributes="Bold" />
                    <Label Grid.Row="2" Text="Total guesses" TextColor="{StaticResource VaultMuted}" />
                    <Label x:Name="GuessCountResultLabel" Grid.Row="2" Grid.Column="1" TextColor="{StaticResource VaultText}" FontAttributes="Bold" />
                    <Label Grid.Row="3" Text="Completion time" TextColor="{StaticResource VaultMuted}" />
                    <Label x:Name="ElapsedTimeResultLabel" Grid.Row="3" Grid.Column="1" TextColor="{StaticResource VaultGreen}" FontAttributes="Bold" />
                </Grid>
            </Border>

            <Button
                Text="PLAY AGAIN"
                Style="{StaticResource VaultPrimaryButton}"
                Clicked="OnPlayAgainClicked" />

            <Button
                Text="HOME"
                Style="{StaticResource VaultSecondaryButton}"
                Clicked="OnHomeClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
