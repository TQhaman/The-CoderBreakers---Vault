<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="The_codebreakers___The_Vault.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:The_codebreakers___The_Vault.Pages"
    Title="VAULT"
    FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{StaticResource VaultBackground}"
    Shell.ForegroundColor="{StaticResource VaultText}"
    Shell.TitleColor="{StaticResource VaultText}">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate pages:HomePage}"
        Route="HomePage" />

</Shell>
